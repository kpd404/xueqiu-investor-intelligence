APP_NAME=Xueqiu Investor Intelligence System
APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/xueqiu_intelligence
DATABASE_ECHO=false
XUEQIU_STORAGE_STATE_PATH=.local/xueqiu/storage_state.json
XUEQIU_PROFILE_PATH=.local/xueqiu/profile
XUEQIU_BROWSER_CHANNEL=msedge
# XUEQIU_BROWSER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
LLM_PROVIDER_ID=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

LLM_API_STYLE=responses
LLM_STRUCTURED_OUTPUT=json_schema
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1
LLM_RETRY_INVALID_STRUCTURED_OUTPUT=true
